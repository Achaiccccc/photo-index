insertSetting:
INSERT INTO setting(
  id, provider, endpoint, model, thinkingEnabled, thinkingTokenLimit,
  longEdge, jpegQuality, detailLevel, uploadMode, batchMaxBytes, batchMaxLines,
  concurrentBatches, wifiOnly, chargingOnly, inputPricePerMillion, outputPricePerMillion,
  matchMode, amountAlertYuan, synonyms
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSetting:
SELECT
  id, provider, endpoint, model, thinkingEnabled, thinkingTokenLimit,
  longEdge, jpegQuality, detailLevel, uploadMode, batchMaxBytes, batchMaxLines,
  concurrentBatches, wifiOnly, chargingOnly, inputPricePerMillion, outputPricePerMillion,
  matchMode, amountAlertYuan, synonyms, deleteResultsOutOfScope
FROM setting
WHERE id = 1;

updateDeleteResultsOutOfScope:
UPDATE setting
SET deleteResultsOutOfScope = :enabled
WHERE id = 1;

countSetting:
SELECT COUNT(*) AS rowCount
FROM setting;

updateSetting:
UPDATE setting
SET
  provider = ?,
  endpoint = ?,
  model = ?,
  thinkingEnabled = ?,
  thinkingTokenLimit = ?,
  longEdge = ?,
  jpegQuality = ?,
  detailLevel = ?,
  uploadMode = ?,
  batchMaxBytes = ?,
  batchMaxLines = ?,
  concurrentBatches = ?,
  wifiOnly = ?,
  chargingOnly = ?,
  inputPricePerMillion = ?,
  outputPricePerMillion = ?,
  matchMode = ?,
  amountAlertYuan = ?,
  synonyms = ?
WHERE id = 1;
