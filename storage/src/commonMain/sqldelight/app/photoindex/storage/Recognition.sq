insertRecognition:
INSERT INTO recognition(assetId, promptVersion, modelId, json, searchText)
VALUES (?, ?, ?, ?, ?);

selectRecognitionByAssetId:
SELECT assetId, promptVersion, modelId, json, searchText
FROM recognition
WHERE assetId = ?;

updateRecognitionSearchText:
UPDATE recognition
SET searchText = ?
WHERE assetId = ?;

replaceRecognition:
UPDATE recognition
SET promptVersion = ?, modelId = ?, json = ?, searchText = ?
WHERE assetId = ?;
